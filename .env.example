# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Configurable Gemini models (free-tier defaults)
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_REASONING_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# External Python FastAPI backend (optional; falls back to transparent Demo Mode when unset)
PYTHON_BACKEND_URL=""
BACKEND_SERVICE_TOKEN=""

# Demo mode flag
DEMO_MODE="true"

# Python Backend Database & Optional Integrations (used in python-backend/)
DATABASE_URL="postgresql+asyncpg://evidenceos:password@localhost:5432/evidenceos"
ENABLE_PADDLE_OCR="false"

# Privacy & Retention Defaults
DEFAULT_DOCUMENT_RETENTION_DAYS="365"

